# Copy this file to .env before starting the app:
#
#   cp example.env .env
#
# config.SetupViper reads .env from the working directory and calls
# log.Fatalf if it is missing, so the app will not boot without it.

# ---------------------------------------------------------------- server
# Port the HTTP server listens on. Defaults to 8080 when unset.
PORT=8080
# Public base URL, published as the `servers` entry in the OpenAPI document.
SERVER_URL=http://localhost:8080

# ---------------------------------------------------------------- logging
# One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=debug
# "json" (default) or "text". Use text for readable local output.
LOG_FORMAT=text

# ---------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eda_monolith
# Set to true once the schema is managed elsewhere, to skip gorm AutoMigrate
# on boot. Defaults to false.
SKIP_AUTO_MIGRATE=false

# ---------------------------------------------------------------- cors
# Comma-separated list of allowed browser origins. Any localhost/127.0.0.1
# origin is allowed on any port regardless of this list, so it only needs to
# name deployed frontends. Defaults to http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------- background worker (asynq)
# Redis connection URL. asynq.ParseRedisURI also accepts rediss://,
# redis-socket:// and redis-sentinel://. The db number can be given as the
# path (redis://localhost:6379/2). Defaults to redis://localhost:6379.
ASYNC_REDIS_URL=redis://localhost:6379
# Queue name tasks are enqueued to and the server consumes. Both sides read
# this, so changing it strands tasks already queued under the old name.
# Defaults to asynq.
ASYNC_REDIS_NAMESPACE=asynq
# Number of tasks processed in parallel. Defaults to 10.
ASYNC_REDIS_CONCURRENCY=10
# Redis db number. Overrides any db in ASYNC_REDIS_URL when non-zero.
ASYNC_REDIS_DB=0
# Optional Redis auth. Leave blank for a local instance with no password.
ASYNC_REDIS_USERNAME=
ASYNC_REDIS_PASSWORD=

# ---------------------------------------------------------------- telemetry
# Accepted by telemetry.StartAppTracer but not yet wired to an exporter —
# spans are created and discarded until one is configured.
UPTRACE_DSN=
UPTRACE_SERVICE_NAME=eda-monolith
UPTRACE_SERVICE_VERSION=1.0.0

RESEND_API_EMAIL=""
RESEND_API_KEY=""
EMAIL_PROVIDER=""
OTP_LENGTH=5
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- auth (jwt)
# Signing key for access and refresh tokens (HS256). SET THIS — if it is empty
# the tokens are signed with an empty key and anyone can forge one. Use a long
# random value; changing it invalidates every token already issued.
JWT_SECRET_KEY=
# Token lifetimes in hours. When unset, services.NewService defaults to
# 1 hour for access and 24 hours for refresh.
JWT_ACCESS_TOKEN_EXPIRY_HOURS=1
JWT_REFRESH_TOKEN_EXPIRY_HOURS=24

# ---------------------------------------------------------------- ledger (tigerbeetle)
# Cluster id the TigerBeetle replicas were formatted with. Defaults to 0.
TB_CLUSTER_ID=0
# Comma-separated replica addresses (a bare port means 127.0.0.1). Defaults to 3000.
TB_ADDRESSES=3000

# Payment verify poller: while a deposit is pending, the provider is checked
# every PAYMENT_POLL_INTERVAL_SECONDS, up to PAYMENT_POLL_MAX_RETRIES times,
# before the deposit is marked FAILED. Defaults: 60 seconds, 30 retries.
PAYMENT_POLL_INTERVAL_SECONDS=60
PAYMENT_POLL_MAX_RETRIES=30
